# Copie ce fichier en « .env » (cp .env.example .env) puis adapte-le.
# Docker Compose le lit automatiquement. Une valeur avec « $ », « # » ou des espaces se met entre apostrophes.

# ── Accès ─────────────────────────────────────────────────────────────────────
# Port publié sur la machine qui héberge Docker.
HOST_PORT=3131
# Interface sur laquelle ce port est publié : 0.0.0.0 = tout le réseau, 127.0.0.1 = cette machine seulement.
# Derrière un reverse proxy (Caddy intégré compris), mets 127.0.0.1 : le proxy reste le seul accès, et personne
# ne peut joindre l'application directement en se faisant passer pour lui.
BIND_ADDRESS=0.0.0.0
# Compte administrateur, créé uniquement au tout premier démarrage.
# Sans mot de passe, un mot de passe aléatoire est affiché une seule fois dans les logs :
#   docker compose logs arr411
ADMIN_USER=admin
ADMIN_PASSWORD=

# ── Derrière un reverse proxy HTTPS (Caddy, Nginx, Traefik, tunnel Cloudflare…) ─
# URL publique, sans « / » final. Laisse vide pour un accès direct en HTTP sur ton réseau.
PUBLIC_URL=
# Nombre de reverse proxies devant l'application : 0 = aucun, 1 = un seul.
# À 1, l'application croit l'adresse IP que le proxy annonce : BIND_ADDRESS=127.0.0.1 (ou un pare-feu) est alors indispensable.
TRUST_PROXY=0
# auto = cookie « Secure » quand la connexion est en HTTPS. true ou false pour forcer.
COOKIE_SECURE=auto
# Nom de domaine pour le profil « https » (Caddy intégré) : docker compose --profile https up -d
DOMAIN=

# ── Connexions initiales (facultatif) ───────────────────────────────────────────
# Ne remplissent QUE les services jamais enregistrés dans Réglages ; tout se règle aussi dans Réglages.
# Dans le conteneur, « localhost » désigne le conteneur lui-même : utilise le nom d'un service
# Docker (http://qbittorrent:8080), l'adresse IP du serveur, ou http://host.docker.internal:PORT.
QBITTORRENT_URL=
QBITTORRENT_USERNAME=
QBITTORRENT_PASSWORD=
RADARR_URL=
RADARR_API_KEY=
SONARR_URL=
SONARR_API_KEY=
LIDARR_URL=
LIDARR_API_KEY=

# ── Vue C411 intégrée (navigateur distant) ──────────────────────────────────────
# Adresse du navigateur distant (conteneur « browser » du compose, jamais publié sur le réseau de la machine).
# Vide = vue C411 désactivée ; pour ne pas construire ni lancer le navigateur : docker compose up -d --build arr411
C411_BROWSER_URL=http://browser:9223
# Nombre maximal de navigateurs ouverts en même temps (un par utilisateur), de 1 à 20.
C411_MAX_SESSIONS=3
# Minutes d'inactivité avant la fermeture du navigateur d'un utilisateur, de 1 à 240.
C411_IDLE_MINUTES=15
# true = ta connexion à c411.org est gardée dans le volume (par utilisateur Arr411, en clair, droits 600).
# false = tu te reconnectes à c411.org à chaque ouverture de la vue.
C411_PERSIST_COOKIES=true
# Sites joignables en plus de c411.org et de la vérification Cloudflare : noms séparés par des virgules,
# « exemple.org » ou « *.exemple.org ». Une page qui reste vide ? Regarde : docker compose logs egress
C411_ALLOWED_HOSTS=
# Fuseau horaire du navigateur (dates affichées par c411.org).
TZ=Europe/Paris
# 1 = Chromium sans écran virtuel (repli si le navigateur ne démarre pas avec l'écran virtuel).
BROWSER_HEADLESS=0

# ── VPN pour la vue C411 (docker-compose.vpn.yml seulement) ────────────────────
# c411.org est bloqué chez ton fournisseur d'accès, ou réservé aux connexions VPN ? Avec docker-compose.vpn.yml, le navigateur
# de la vue C411 sort par un conteneur « gluetun » (client VPN) ; rien d'autre ne passe par le VPN. Ces variables sont
# ignorées par docker-compose.yml et docker-compose.ghcr.yml. Fournisseurs et réglages : https://github.com/qdm12/gluetun-wiki
# Un VPN qui ne se monte pas ? Regarde : docker compose logs gluetun (TZ, plus haut, règle aussi son fuseau horaire).
# Fournisseur, obligatoire : protonvpn, mullvad, nordvpn, surfshark, airvpn, custom…
VPN_SERVICE_PROVIDER=
# wireguard ou openvpn.
VPN_TYPE=wireguard
# WireGuard : auto, kernelspace ou userspace.
WIREGUARD_IMPLEMENTATION=auto
# WireGuard : off si les journaux de gluetun montrent « Failed to write packets to TUN device … invalid argument » (noyaux de certains NAS). Vide : réglage de gluetun (on).
WIREGUARD_GSO=
# WireGuard : clé privée donnée par ton fournisseur. SECRET : ne la partage pas.
WIREGUARD_PRIVATE_KEY=
# WireGuard : adresse du tunnel (par exemple 10.2.0.2/32), seulement si ton fournisseur l'exige.
WIREGUARD_ADDRESSES=
# OpenVPN (VPN_TYPE=openvpn) : identifiant et mot de passe du fournisseur. SECRETS.
OPENVPN_USER=
OPENVPN_PASSWORD=
# Pays des serveurs, séparés par des virgules (par exemple Switzerland,Netherlands). Vide = au choix du fournisseur.
SERVER_COUNTRIES=

# ── Avancé ──────────────────────────────────────────────────────────────────────
# Durée d'une session, en jours.
SESSION_DAYS=7
# Clé de signature des sessions (16 caractères minimum). Vide = générée et gardée dans le volume.
SESSION_SECRET=
# true pour accepter les certificats HTTPS auto-signés de tes services.
INSECURE_UPSTREAM_TLS=false
# Par principe, Arr411 n'ajoute rien en « surveillé » et ne lance aucune recherche ni synchro RSS.
# true lève ce blocage côté serveur (déconseillé).
ALLOW_SEARCH_COMMANDS=false
# true pour journaliser chaque requête.
LOG_REQUESTS=false
# Taille maximale d'un fichier .torrent envoyé, en Mo.
MAX_UPLOAD_MB=25
